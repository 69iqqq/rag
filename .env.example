# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini - server-side only, never prefix with NEXT_PUBLIC_
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin a model. Run `npm run gemini:models` to see what your key can use.
# Default tries gemini-3.8-flash, then gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.8-flash
